 /* CREATE database employee_db; */
 /* USE employee_db; */
 +-------------+
| database()  |
+-------------+
| employee_db |
+-------------+
 /* CREATE TABLE employee ( id INT PRIMARY KEY, name VARCHAR(100) NOT NULL, salary DOUBLE NOT NULL ); */


 /* Add employee */
 INSERT INTO employee (id, name, salary)
 VALUES (1, 'Amit', 50000),
 (2, 'Abhijeet', 45000),
 (3, 'Muskan', 60000),
 (4,'Soumya', 70000),
 (5,'Anuj',65000);
 /* Query OK, 4 rows affected (0.0177 sec) */


 /* View all employees */
SELECT * FROM employee;
+----+----------+--------+
| id | name     | salary |
+----+----------+--------+
|  1 | Amit     |  50000 |
|  2 | Abhijeet |  45000 |
|  3 | Muskan   |  60000 |
|  4 | Soumya   |  70000 |
|  5 | Anuj     |  65000 |
+----+----------+--------+
/* Update salary */
UPDATE employee SET salary =72000 WHERE ID =2
 +----+----------+--------+
| id | name     | salary |
+----+----------+--------+
|  1 | Amit     |  50000 |
|  2 | Abhijeet |  72000 |
|  3 | Muskan   |  60000 |
|  4 | Soumya   |  70000 |
|  5 | Anuj     |  65000 |
+----+----------+--------
/*Delete from the table*/
Delete from employee where id =3;
+----+----------+--------+
| id | name     | salary |
+----+----------+--------+
|  1 | Amit     |  50000 |
|  2 | Abhijeet |  72000 |
|  4 | Soumya   |  70000 |
|  5 | Anuj     |  65000 |
+----+----------+--------
/*Search employee with name*/
SELECT * FROM EMPLOYEE WHERE name = 'Abhijeet';
+----+----------+--------+
| id | name     | salary |
+----+----------+--------+
|  2 | Abhijeet |  72000 |
